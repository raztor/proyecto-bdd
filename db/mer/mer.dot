// Modelo Entidad-Relación (MER) — notación Chen.
//
//   Entidades       : rectángulos (azul).
//   Relaciones      : rombos (naranja).
//   Atributos       : elipses (gris); las llaves primarias van subrayadas.
//   Cardinalidades  : notación (mín,máx) ubicada junto a cada entidad.
//                     Lectura "look-across": el par junto a la entidad E indica
//                     cuántas instancias de E se asocian a UNA instancia de la
//                     entidad del otro extremo de la relación (igual que el
//                     formato del enunciado: USUARIO (1,1) crea (0,N) LISTA).
//
// Las claves foráneas, índices y restricciones físicas (FK compuestas,
// EXCLUDE, CHECK, triggers) NO aparecen aquí: corresponden al modelo físico
// (`modelo_fisico.svg`) y al DDL en `db/relational/01_schema.sql`.

graph MER {
    layout=dot;
    rankdir=LR;
    bgcolor="white";
    splines=true;
    overlap=false;
    nodesep=0.75;
    ranksep=1.4;
    sep="+12";
    graph [fontname="Helvetica", pad="0.4"];
    edge  [fontname="Helvetica", fontsize=9, color="#37474F"];

    // ──────────────── ENTIDADES ────────────────
    node [shape=box, style="filled,rounded", fillcolor="#E3F2FD",
          color="#1565C0", fontname="Helvetica", fontsize=11, penwidth=1.4];

    E_region              [label="REGION"];
    E_comuna              [label="COMUNA"];
    E_estacion            [label="ESTACION"];
    E_unidad              [label="UNIDAD_MEDIDA"];
    E_contaminante        [label="CONTAMINANTE"];
    E_categoria           [label="CATEGORIA_CALIDAD"];
    E_episodio            [label="EPISODIO"];
    E_reporte             [label="REPORTE_CIUDADANO"];
    E_idioma              [label="IDIOMA"];
    // MEDICION es entidad débil: solo existe asociada a una instancia de la
    // relación `mide` (par estación-contaminante declarado). Doble borde
    // según convención Chen.
    E_medicion            [label="MEDICION", peripheries=2];
    E_auditoria           [label="EVENTO_AUDITORIA"];

    // ──────────────── RELACIONES ────────────────
    node [shape=diamond, style="filled", fillcolor="#FFE0B2",
          color="#E65100", fontname="Helvetica", fontsize=10, penwidth=1.2];

    R_pertenece    [label="pertenece"];
    R_ubicada      [label="ubicada\nen"];
    R_expresa      [label="se\nexpresa"];
    R_mide         [label="mide"];
    R_registra     [label="registra\n(cosificación)"];
    R_clasifica    [label="clasifica"];
    R_ocurre       [label="ocurre\nen"];
    R_afecta       [label="afecta\na"];
    R_califica     [label="se\ncalifica"];
    R_involucra    [label="involucra"];
    R_emite        [label="emite"];
    R_trad_cont    [label="traduce"];
    R_trad_cat     [label="traduce"];

    // ──────────────── ATRIBUTOS ────────────────
    node [shape=ellipse, style="solid", color="#546E7A",
          fillcolor="white", fontname="Helvetica", fontsize=9, penwidth=1.0];

    // claves primarias (subrayadas)
    A_reg_id       [label=<<u>id</u>>];
    A_com_id       [label=<<u>id</u>>];
    A_est_id       [label=<<u>id</u>>];
    A_uni_id       [label=<<u>id</u>>];
    A_con_id       [label=<<u>id</u>>];
    A_cat_id       [label=<<u>id</u>>];
    A_epi_id       [label=<<u>id</u>>];
    A_rep_id       [label=<<u>id</u>>];
    A_idi_codigo   [label=<<u>codigo</u>>];
    A_med_id       [label=<<u>id</u>>];
    A_aud_id       [label=<<u>id</u>>];

    // atributos descriptivos clave por entidad
    A_reg_codigo   [label="codigo"];

    A_com_nombre   [label="nombre"];
    A_com_pob      [label="poblacion"];

    A_est_nombre   [label="nombre"];
    A_est_lat      [label="latitud"];
    A_est_lon      [label="longitud"];
    A_est_fecha    [label="fecha_instalacion"];

    A_uni_simbolo  [label="simbolo"];
    A_con_codigo   [label="codigo"];

    A_cat_codigo   [label="codigo"];
    A_cat_rango    [label="rango\n(numrange)"];
    A_cat_color    [label="color_hex"];

    A_epi_fecha    [label="fecha"];

    A_rep_fecha    [label="fecha_hora"];
    A_rep_nivel    [label="nivel_percibido"];

    A_med_fecha    [label="fecha_hora"];
    A_med_valor    [label="valor"];
    A_med_validado [label="validado"];

    A_idi_nombre   [label="nombre"];

    A_aud_op       [label="operacion"];
    A_aud_rec      [label="recurso"];
    A_aud_fecha    [label="ocurrido_en"];
    A_aud_usuario  [label="usuario_logico"];
    A_aud_resultado[label="resultado"];
    A_aud_base     [label="base_datos"];
    A_aud_crit     [label="criterio"];
    A_aud_antes    [label="datos_antes"];
    A_aud_despues  [label="datos_despues"];

    // atributos SOBRE relaciones (rasgo Chen)
    A_mide_activo  [label="activo"];
    A_inv_prom     [label="valor_promedio"];
    A_tc_nombre    [label="nombre"];
    A_tc_desc      [label="descripcion"];
    A_tcat_nombre  [label="nombre"];
    A_tcat_reco    [label="recomendacion"];

    // ──────────────── ARISTAS ENTIDAD ↔ RELACIÓN ────────────────
    // La cardinalidad (mín,máx) se rotula junto a cada entidad: taillabel
    // cuando la entidad es el origen de la arista, headlabel cuando es el
    // destino. Así el par queda "al inicio de la línea", pegado a su entidad.
    edge [penwidth=1.1, labeldistance=4.0, labelangle=12, fontsize=9];

    // 1) REGION 1 — N COMUNA  (pertenece)
    E_region    -- R_pertenece [taillabel="(1,1)"];
    R_pertenece -- E_comuna    [headlabel="(0,N)"];

    // 2) COMUNA 1 — N ESTACION  (ubicada en)
    E_comuna   -- R_ubicada  [taillabel="(1,1)"];
    R_ubicada  -- E_estacion [headlabel="(0,N)"];

    // 3) CONTAMINANTE N — 1 UNIDAD_MEDIDA  (se expresa)
    E_contaminante -- R_expresa [taillabel="(0,N)"];
    R_expresa      -- E_unidad  [headlabel="(1,1)"];

    // 4) ESTACION N — M CONTAMINANTE  (mide)   con atributo "activo"
    E_estacion     -- R_mide         [taillabel="(0,N)"];
    R_mide         -- E_contaminante [headlabel="(0,N)"];

    // 5) MEDICION (entidad débil) -- registra --> mide (cosificación)
    //    Cada MEDICION pertenece a UNA instancia declarada de `mide`
    //    (un par estación-contaminante habilitado). Cada par habilitado
    //    puede acumular N mediciones. Esta es la forma Chen-correcta de
    //    expresar la dependencia que en el modelo físico se materializa
    //    como FK compuesta de `medicion` hacia `estacion_contaminante`.
    E_medicion     -- R_registra [taillabel="(0,N)"];
    R_registra     -- R_mide     [headlabel="(1,1)"];

    // 6) CONTAMINANTE 1 — N CATEGORIA_CALIDAD  (clasifica)
    E_contaminante -- R_clasifica [taillabel="(1,1)"];
    R_clasifica    -- E_categoria [headlabel="(0,N)"];

    // 7) EPISODIO N — 1 COMUNA  (ocurre en)
    E_episodio -- R_ocurre [taillabel="(0,N)"];
    R_ocurre   -- E_comuna [headlabel="(1,1)"];

    // 8) EPISODIO N — 1 CONTAMINANTE  (afecta a)
    E_episodio -- R_afecta       [taillabel="(0,N)"];
    R_afecta   -- E_contaminante [headlabel="(1,1)"];

    // 9) EPISODIO N — 1 CATEGORIA_CALIDAD  (se califica)
    E_episodio -- R_califica  [taillabel="(0,N)"];
    R_califica -- E_categoria [headlabel="(1,1)"];

    // 10) EPISODIO N — M ESTACION  (involucra)  con atributo "valor_promedio"
    E_episodio  -- R_involucra [taillabel="(0,N)"];
    R_involucra -- E_estacion  [headlabel="(0,N)"];

    // 11) COMUNA 1 — N REPORTE_CIUDADANO  (emite)
    E_comuna -- R_emite   [taillabel="(1,1)"];
    R_emite  -- E_reporte [headlabel="(0,N)"];

    // 12) CONTAMINANTE N — M IDIOMA  (traduce)  con atributos nombre, descripcion
    E_contaminante -- R_trad_cont [taillabel="(0,N)"];
    R_trad_cont    -- E_idioma    [headlabel="(0,N)"];

    // 13) CATEGORIA_CALIDAD N — M IDIOMA  (traduce)  con atributos nombre, recomendacion
    E_categoria -- R_trad_cat [taillabel="(0,N)"];
    R_trad_cat  -- E_idioma   [headlabel="(0,N)"];

    // ──────────────── ARISTAS ATRIBUTO ↔ ENTIDAD ────────────────
    edge [penwidth=0.9, color="#90A4AE"];

    E_region -- A_reg_id;
    E_region -- A_reg_codigo;

    E_comuna -- A_com_id;
    E_comuna -- A_com_nombre;
    E_comuna -- A_com_pob;

    E_estacion -- A_est_id;
    E_estacion -- A_est_nombre;
    E_estacion -- A_est_lat;
    E_estacion -- A_est_lon;
    E_estacion -- A_est_fecha;

    E_unidad -- A_uni_id;
    E_unidad -- A_uni_simbolo;

    E_contaminante -- A_con_id;
    E_contaminante -- A_con_codigo;

    E_categoria -- A_cat_id;
    E_categoria -- A_cat_codigo;
    E_categoria -- A_cat_rango;
    E_categoria -- A_cat_color;

    E_episodio -- A_epi_id;
    E_episodio -- A_epi_fecha;

    E_reporte -- A_rep_id;
    E_reporte -- A_rep_fecha;
    E_reporte -- A_rep_nivel;

    E_medicion -- A_med_id;
    E_medicion -- A_med_fecha;
    E_medicion -- A_med_valor;
    E_medicion -- A_med_validado;

    E_idioma -- A_idi_codigo;
    E_idioma -- A_idi_nombre;

    E_auditoria -- A_aud_id;
    E_auditoria -- A_aud_op;
    E_auditoria -- A_aud_rec;
    E_auditoria -- A_aud_fecha;
    E_auditoria -- A_aud_usuario;
    E_auditoria -- A_aud_resultado;
    E_auditoria -- A_aud_base;
    E_auditoria -- A_aud_crit;
    E_auditoria -- A_aud_antes;
    E_auditoria -- A_aud_despues;

    // ──────────────── ATRIBUTOS SOBRE RELACIONES ────────────────
    R_mide      -- A_mide_activo;
    R_involucra -- A_inv_prom;
    R_trad_cont -- A_tc_nombre;
    R_trad_cont -- A_tc_desc;
    R_trad_cat  -- A_tcat_nombre;
    R_trad_cat  -- A_tcat_reco;

    // ──────────────── LEYENDA ────────────────
    // Restricciones que el MER no expresa formalmente y que se materializan en
    // el modelo físico (FK compuestas, EXCLUDE, triggers). Se incluyen aquí
    // como nota para evitar ambigüedad en la lectura del diagrama.
    leyenda [
        shape=note,
        style="filled",
        fillcolor="#FFF9C4",
        color="#9E9D24",
        fontname="Helvetica",
        fontsize=9,
        penwidth=1.0,
        label=<<table border="0" cellborder="0" cellspacing="2" cellpadding="2">
          <tr><td align="left"><b>Notas de modelado</b></td></tr>
          <tr><td align="left">• <b>registra</b>: solo válida para pares (estación, contaminante)</td></tr>
          <tr><td align="left">  declarados en <b>mide</b>. Restricción formalizada vía FK</td></tr>
          <tr><td align="left">  compuesta en el modelo físico.</td></tr>
          <tr><td align="left">• <b>involucra</b>: la estación debe pertenecer a la misma</td></tr>
          <tr><td align="left">  comuna donde ocurre el episodio (FK compuesta).</td></tr>
          <tr><td align="left">• <b>clasifica</b>: dos categorías del mismo contaminante</td></tr>
          <tr><td align="left">  no pueden solapar sus rangos (EXCLUDE USING gist).</td></tr>
          <tr><td align="left">• <b>se califica</b>: la categoría asignada al episodio debe</td></tr>
          <tr><td align="left">  corresponder al mismo contaminante (FK compuesta</td></tr>
          <tr><td align="left">  (contaminante_id, categoria_id) en el modelo físico).</td></tr>
          <tr><td align="left">• <b>EVENTO_AUDITORIA</b> ≡ tabla "evento_auditoria_relacional"</td></tr>
          <tr><td align="left">  en el modelo físico. No tiene FK al dominio: el vínculo se</td></tr>
          <tr><td align="left">  realiza por triggers sobre cada tabla auditada.</td></tr>
          <tr><td align="left">• La proyección no relacional de auditoría (colección Mongo</td></tr>
          <tr><td align="left">  "auditoria") se documenta en db/nosql/.</td></tr>
        </table>>
    ];
}
