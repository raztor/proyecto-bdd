{
  "name": "calidad-aire-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API del POC — Indicador ODS 11.6.2 (PM2.5/PM10). Express + TypeScript + PostgreSQL + MongoDB.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
