# ── PostgreSQL (base de datos relacional) ─────────────────────────────────
# Usados por docker-compose para crear el contenedor:
POSTGRES_USER=calidad_app
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=calidad_aire
POSTGRES_PORT=5432

# Usados por el backend para conectarse (corriendo en el host -> contenedor):
PG_HOST=localhost
PG_PORT=5432
PG_USER=calidad_app
PG_PASSWORD=cambia_esta_clave
PG_DATABASE=calidad_aire

# ── MongoDB (base de datos no relacional / log de auditoría) ──────────────
MONGO_PORT=27017
MONGO_URL=mongodb://localhost:27017
MONGO_DB=calidad_aire_audit

# ── Backend (API) ─────────────────────────────────────────────────────────
PORT=3000
# Origen permitido para CORS (servidor de desarrollo de Vite):
CORS_ORIGIN=http://localhost:5173

# ── Seed (datos sintéticos) ────────────────────────────────────────────────
# Meses de histórico horario a generar por cada par estación-contaminante.
# 3 meses x ~32 pares x ~24 h ≈ 69.000 mediciones (supera con creces los 1.000).
SEED_MESES=3

# ── OpenAQ (importar estaciones reales) ─────────────────────────────────────
# Clave gratuita en https://explore.openaq.org/register
# Sin esta clave, la importación de estaciones devuelve 503 (lo demás funciona).
OPENAQ_API_KEY=

# ── Collector de mediciones (servicio opcional: --profile collector) ────────
# Rango geográfico a sondear y frecuencia (minutos).
COLLECTOR_BBOX=-70.9,-33.7,-70.4,-33.2
COLLECTOR_INTERVAL_MIN=60

# ── Geocodificador (buscador de ubicación) — GRATIS, sin API key ────────────
# Nominatim/OpenStreetMap. Valores por defecto OK; cámbialos solo si self-hosteas.
# La política de uso pide un User-Agent identificatorio y un uso moderado.
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=calidad-aire-poc/0.1
